#version 450
// SnapMotionV2 refinement: componentwise 3x3 median, subpixel SAD refinement
// and local confidence. Forward/backward validation is a separate pass.
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0) uniform sampler2D uFlowIn;
layout(set = 0, binding = 1) uniform sampler2D uLumaCurr;
layout(set = 0, binding = 2) uniform sampler2D uLumaPrev;
layout(set = 0, binding = 4, rgba16f) writeonly uniform image2D uFlowOut;
layout(push_constant) uniform Push {
    vec4 dims; // lumaW, lumaH, blocksX, blocksY
    vec4 tune; // x = costScale, y = agreementScale, z/w reserved
} pc;
const int BLOCK = 8;
const float INVALID_COST = 1.0e6;
float sadAt(ivec2 block, vec2 mv) {
    ivec2 base = block * BLOCK;
    ivec2 extent = textureSize(uLumaCurr, 0);
    float sad = 0.0;
    int samples = 0;
    for (int y = 0; y < BLOCK; ++y) {
        for (int x = 0; x < BLOCK; ++x) {
            ivec2 p = base + ivec2(x, y);
            if (any(greaterThanEqual(p, extent))) continue;
            vec2 q = (vec2(p) + 0.5 + mv) / vec2(extent);
            if (any(lessThan(q, vec2(0.0))) || any(greaterThanEqual(q, vec2(1.0))))
                return INVALID_COST;
            float a = texelFetch(uLumaCurr, p, 0).r;
            float b = texture(uLumaPrev, q).r;
            sad += abs(a - b);
            ++samples;
        }
    }
    return samples > 0 ? sad / float(samples) : INVALID_COST;
}
float median9(float values[9]) {
    for (int i = 1; i < 9; ++i) {
        float key = values[i];
        int j = i - 1;
        while (j >= 0 && values[j] > key) {
            values[j + 1] = values[j];
            --j;
        }
        values[j + 1] = key;
    }
    return values[4];
}
void main() {
    ivec2 block = ivec2(gl_GlobalInvocationID.xy);
    ivec2 blocks = imageSize(uFlowOut);
    if (any(greaterThanEqual(block, blocks))) return;
    float xs[9];
    float ys[9];
    int k = 0;
    for (int dy = -1; dy <= 1; ++dy) {
        for (int dx = -1; dx <= 1; ++dx) {
            ivec2 q = clamp(block + ivec2(dx, dy), ivec2(0), blocks - ivec2(1));
            vec2 v = texelFetch(uFlowIn, q, 0).xy;
            xs[k] = v.x;
            ys[k] = v.y;
            ++k;
        }
    }
    vec2 medianFlow = vec2(median9(xs), median9(ys));
    float centerCost = sadAt(block, medianFlow);
    float leftCost = sadAt(block, medianFlow + vec2(-1.0, 0.0));
    float rightCost = sadAt(block, medianFlow + vec2(1.0, 0.0));
    float upCost = sadAt(block, medianFlow + vec2(0.0, -1.0));
    float downCost = sadAt(block, medianFlow + vec2(0.0, 1.0));
    float denomX = 2.0 * centerCost - leftCost - rightCost;
    float denomY = 2.0 * centerCost - upCost - downCost;
    float subX = abs(denomX) > 1.0e-5
        ? clamp(0.5 * (rightCost - leftCost) / denomX, -0.5, 0.5) : 0.0;
    float subY = abs(denomY) > 1.0e-5
        ? clamp(0.5 * (downCost - upCost) / denomY, -0.5, 0.5) : 0.0;
    vec2 refined = medianFlow + vec2(subX, subY);
    vec4 raw = texelFetch(uFlowIn, block, 0);
    float agreement = length(raw.xy - medianFlow) / (1.0 + length(medianFlow));
    float costConfidence = clamp(1.0 - max(raw.z, centerCost) * pc.tune.x, 0.0, 1.0);
    float agreementConfidence = clamp(1.0 - agreement * pc.tune.y, 0.0, 1.0);
    imageStore(uFlowOut, block, vec4(refined, centerCost,
        costConfidence * agreementConfidence));
}
