#version 450
// SnapMotionV2 bidirectional temporal warp with confidence fallback, static
// region preservation and neighborhood gamut clamp. Inputs are two real frames.
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0) uniform sampler2D uBackwardFlow;
layout(set = 0, binding = 1) uniform sampler2D uPreviousColor;
layout(set = 0, binding = 2) uniform sampler2D uCurrentColor;
layout(set = 0, binding = 3) uniform sampler2D uValidation;
layout(set = 0, binding = 4) uniform sampler2D uStaticMask;
layout(set = 0, binding = 5, rgba16f) writeonly uniform image2D uTarget;
layout(push_constant) uniform Push {
    vec4 dims;   // dstW, dstH, flowW, flowH
    vec4 params; // x = interpolation time t
    vec4 tune;   // x = gamut strength, y = confidence floor, z = sharpen
} pc;
void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    ivec2 dst = imageSize(uTarget);
    if (any(greaterThanEqual(p, dst))) return;
    vec2 uv = (vec2(p) + 0.5) / vec2(dst);
    vec2 flowSize = max(pc.dims.zw, vec2(1.0));
    float t = clamp(pc.params.x, 0.0, 1.0);
    vec4 flow = texture(uBackwardFlow, uv);
    vec2 backward = flow.xy;
    float confidence = clamp(flow.w, 0.0, 1.0)
                     * clamp(texture(uValidation, uv).r, 0.0, 1.0);
    vec2 uvPrev = uv + backward * (t / flowSize);
    vec2 uvCurr = uv - backward * ((1.0 - t) / flowSize);
    bool inPrev = all(greaterThanEqual(uvPrev, vec2(0.0)))
               && all(lessThan(uvPrev, vec2(1.0)));
    bool inCurr = all(greaterThanEqual(uvCurr, vec2(0.0)))
               && all(lessThan(uvCurr, vec2(1.0)));
    vec3 prev = texture(uPreviousColor, clamp(uvPrev, vec2(0.0), vec2(1.0))).rgb;
    vec3 curr = texture(uCurrentColor, clamp(uvCurr, vec2(0.0), vec2(1.0))).rgb;
    vec3 blended = mix(prev, curr, t);
    if (inCurr) {
        vec2 texel = 1.0 / vec2(dst);
        vec2 sampleUv = clamp(uvCurr, vec2(0.0), vec2(1.0));
        vec3 n1 = texture(uCurrentColor, clamp(sampleUv + vec2(-texel.x, 0.0), vec2(0.0), vec2(1.0))).rgb;
        vec3 n2 = texture(uCurrentColor, clamp(sampleUv + vec2( texel.x, 0.0), vec2(0.0), vec2(1.0))).rgb;
        vec3 n3 = texture(uCurrentColor, clamp(sampleUv + vec2(0.0, -texel.y), vec2(0.0), vec2(1.0))).rgb;
        vec3 n4 = texture(uCurrentColor, clamp(sampleUv + vec2(0.0,  texel.y), vec2(0.0), vec2(1.0))).rgb;
        vec3 minColor = min(min(min(curr, n1), min(n2, n3)), n4);
        vec3 maxColor = max(max(max(curr, n1), max(n2, n3)), n4);
        vec3 detail = curr - 0.25 * (n1 + n2 + n3 + n4);
        blended += clamp(pc.tune.z, 0.0, 1.0) * detail;
        blended = mix(blended, clamp(blended, minColor, maxColor),
                      clamp(pc.tune.x, 0.0, 1.0));
    }
    vec3 nearest = (t < 0.5) ? prev : curr;
    float useBlend = max(confidence, clamp(pc.tune.y, 0.0, 1.0));
    if (!inPrev) { blended = curr; nearest = curr; useBlend = 1.0; }
    if (!inCurr) { blended = prev; nearest = prev; useBlend = 1.0; }
    vec3 color = mix(nearest, blended, useBlend);
    float staticMask = clamp(texture(uStaticMask, uv).r, 0.0, 1.0);
    color = mix(color, texture(uCurrentColor, uv).rgb, staticMask);
    imageStore(uTarget, p, vec4(color, 1.0));
}
