#version 450
// First-stage reduction: one 8x8 workgroup writes one compact partial record.
// No atomics and no CPU readback are performed by this shader.
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0) uniform sampler2D uRefinedFlow;   // xy=motion, w=confidence
layout(set = 0, binding = 1) uniform sampler2D uValidation;    // R16F, 1=valid
layout(set = 0, binding = 2) uniform sampler2D uStaticMask;    // R16F, 1=static
layout(set = 0, binding = 3) uniform sampler2D uCurrentLuma;
layout(set = 0, binding = 4) uniform sampler2D uPreviousLuma;
struct PartialMetrics { vec4 motion; vec4 quality; };
layout(set = 0, binding = 5, std430) writeonly buffer PartialBuffer {
    PartialMetrics partials[];
} outPart;
shared vec4 sMotion[64];
shared vec4 sQuality[64];
void main() {
    uint lane = gl_LocalInvocationIndex;
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    ivec2 extent = textureSize(uRefinedFlow, 0);
    vec4 motion = vec4(0.0);
    vec4 quality = vec4(0.0);
    if (all(lessThan(p, extent))) {
        vec4 f = texelFetch(uRefinedFlow, p, 0);
        vec2 left = texelFetch(uRefinedFlow, clamp(p + ivec2(-1, 0), ivec2(0), extent - 1), 0).xy;
        vec2 right = texelFetch(uRefinedFlow, clamp(p + ivec2(1, 0), ivec2(0), extent - 1), 0).xy;
        vec2 up = texelFetch(uRefinedFlow, clamp(p + ivec2(0, -1), ivec2(0), extent - 1), 0).xy;
        vec2 down = texelFetch(uRefinedFlow, clamp(p + ivec2(0, 1), ivec2(0), extent - 1), 0).xy;
        float magnitude = length(f.xy);
        float variation = 0.25 * (length(f.xy-left) + length(f.xy-right)
                                 + length(f.xy-up) + length(f.xy-down));
        float confidence = clamp(f.w, 0.0, 1.0);
        float validation = clamp(texelFetch(uValidation, p, 0).r, 0.0, 1.0);
        float staticValue = clamp(texelFetch(uStaticMask, p, 0).r, 0.0, 1.0);
        ivec2 lumaExtent = textureSize(uCurrentLuma, 0);
        ivec2 center = min(p * 8 + ivec2(4), lumaExtent - ivec2(1));
        float photometricDelta = abs(texelFetch(uCurrentLuma, center, 0).r
                                   - texelFetch(uPreviousLuma, center, 0).r);
        motion = vec4(magnitude, variation / (1.0 + variation),
                      confidence, confidence < 0.1 ? 1.0 : 0.0);
        quality = vec4(1.0 - validation, staticValue, photometricDelta, 1.0);
    }
    sMotion[lane] = motion;
    sQuality[lane] = quality;
    barrier();
    for (uint stride = 32u; stride > 0u; stride >>= 1u) {
        if (lane < stride) {
            sMotion[lane] += sMotion[lane + stride];
            sQuality[lane] += sQuality[lane + stride];
        }
        barrier();
    }
    if (lane == 0u) {
        uint groupIndex = gl_WorkGroupID.y * gl_NumWorkGroups.x + gl_WorkGroupID.x;
        outPart.partials[groupIndex].motion = sMotion[0];
        outPart.partials[groupIndex].quality = sQuality[0];
    }
}
